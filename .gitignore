# Database
*.db
*.db-journal
*.db-wal
*.db-shm

# Binaries
/openchore
/server
/cmd/server/server

# Frontend
/node_modules/
web/node_modules/
web/dist/
web/.vitest/

# E2E tests
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/pwa-report.json

# Debug/test scripts
web/debug-*.mjs

# Config (user's real config — copy config.example.yaml to config.yaml)
config/config.yaml

# OS
.DS_Store

# Python build artifacts
__pycache__/
*.pyc

# Runtime data (uploads, TTS audio, profiling)
data/
default.profraw
internal/*/data/

# internal/taxonomy/data 是 go:embed 编译期数据（3108 知识点 / 12579 题），
# 必须随仓库走：干净 checkout（CI）缺它则 `go build`/`go test` 直接失败
# （pattern data/*.json: no matching files）。上两级目录被忽略时，git
# 对已忽略目录内的文件不再展开，需逐级否定。
!internal/taxonomy/
!internal/taxonomy/data/
!internal/taxonomy/data/**

# Temp
/tmp/

# Editor/Agent
.claude/
